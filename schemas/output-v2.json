{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ansibleguard://schemas/output-v2.json",
  "title": "AnsibleGuard v0.0.5 output envelope",
  "description": "Common envelope for versioned AnsibleGuard findings, diagnostics, occurrences, and metadata.",
  "type": "object",
  "required": ["schema_version", "contract", "kind"],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "contract": {
      "const": "ansibleguard://schemas/output-v2.json"
    },
    "kind": {
      "type": "string",
      "enum": [
        "contract-manifest",
        "run-metadata",
        "file-selection",
        "raw-findings",
        "canonical-occurrences",
        "diagnostics",
        "review-metrics",
        "file-metrics",
        "file-report",
        "run-report",
        "legacy-layout",
        "diff-report"
      ]
    },
    "items": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
