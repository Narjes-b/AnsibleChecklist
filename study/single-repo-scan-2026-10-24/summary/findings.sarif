{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AnsibleGuard",
          "informationUri": "https://github.com/ansibleguard/ansibleguard",
          "version": "0.0.1",
          "rules": [
            {
              "id": "hardcoded-credentials",
              "shortDescription": {
                "text": "A hardcoded secret was detected by GitLeaks."
              },
              "fullDescription": {
                "text": "A hardcoded secret was detected by GitLeaks."
              },
              "help": {
                "text": "Remove the literal secret, rotate it if live, and load it from Ansible Vault or an approved secret manager."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "security",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "RISK",
                "actionability": "blocking"
              }
            },
            {
              "id": "credentials-leaking-in-log",
              "shortDescription": {
                "text": "A task handles a sensitive value without no_log: true."
              },
              "fullDescription": {
                "text": "A task handles a sensitive value without no_log: true."
              },
              "help": {
                "text": "Set effective no_log: true on the sensitive task or block and avoid printing the sensitive result."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "security",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "RISK",
                "actionability": "blocking"
              }
            },
            {
              "id": "overriden-keys",
              "shortDescription": {
                "text": "A duplicate mapping key silently discards a value."
              },
              "fullDescription": {
                "text": "A duplicate mapping key silently discards a value."
              },
              "help": {
                "text": "Keep one mapping entry for the key and merge the intended values explicitly."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "correctness",
                "confidence": "high",
                "status": "stable",
                "taxonomy": "DEFECT",
                "actionability": "actionable"
              }
            },
            {
              "id": "missing-bool-filters",
              "shortDescription": {
                "text": "A when: condition compares against a quoted boolean string."
              },
              "fullDescription": {
                "text": "A when: condition compares against a quoted boolean string."
              },
              "help": {
                "text": "Convert the value explicitly with | bool or use a native boolean expression."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "correctness",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "DEFECT",
                "actionability": "actionable"
              }
            },
            {
              "id": "overriding-facts",
              "shortDescription": {
                "text": "A set_fact variable is reassigned with a different value."
              },
              "fullDescription": {
                "text": "A set_fact variable is reassigned with a different value."
              },
              "help": {
                "text": "Use one authoritative assignment or rename facts whose values represent different states."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "correctness",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "DEFECT",
                "actionability": "actionable"
              }
            },
            {
              "id": "duplicated-code",
              "shortDescription": {
                "text": "Duplicate task blocks detected."
              },
              "fullDescription": {
                "text": "Duplicate task blocks detected."
              },
              "help": {
                "text": "Extract the repeated task body into an included task file or role when the duplication is intentional reuse."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "maintainability",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "MAINTAINABILITY_SIGNAL",
                "actionability": "actionable"
              }
            },
            {
              "id": "high-coupling",
              "shortDescription": {
                "text": "High number of imports/roles."
              },
              "fullDescription": {
                "text": "High number of imports/roles."
              },
              "help": {
                "text": "Review whether imports and roles can be grouped behind a smaller, cohesive role interface."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "maintainability",
                "confidence": "low",
                "status": "experimental",
                "taxonomy": "MAINTAINABILITY_SIGNAL",
                "actionability": "actionable"
              }
            },
            {
              "id": "large-playbook",
              "shortDescription": {
                "text": "Playbook exceeds size thresholds."
              },
              "fullDescription": {
                "text": "Playbook exceeds size thresholds."
              },
              "help": {
                "text": "Split independent responsibilities into roles or imported playbooks after confirming the threshold is appropriate."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "maintainability",
                "confidence": "low",
                "status": "stable",
                "taxonomy": "MAINTAINABILITY_SIGNAL",
                "actionability": "actionable"
              }
            },
            {
              "id": "complex-playbook",
              "shortDescription": {
                "text": "Playbook exceeds complexity thresholds."
              },
              "fullDescription": {
                "text": "Playbook exceeds complexity thresholds."
              },
              "help": {
                "text": "Separate unrelated responsibilities and reduce deeply connected imports, roles, or task groups."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "maintainability",
                "confidence": "low",
                "status": "stable",
                "taxonomy": "MAINTAINABILITY_SIGNAL",
                "actionability": "actionable"
              }
            },
            {
              "id": "insufficient-modularization",
              "shortDescription": {
                "text": "Playbook is large with many plays -- consider splitting."
              },
              "fullDescription": {
                "text": "Playbook is large with many plays -- consider splitting."
              },
              "help": {
                "text": "Move cohesive play groups into roles or imported playbooks with explicit interfaces."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "maintainability",
                "confidence": "low",
                "status": "stable",
                "taxonomy": "MAINTAINABILITY_SIGNAL",
                "actionability": "actionable"
              }
            },
            {
              "id": "large-play",
              "shortDescription": {
                "text": "A play exceeds size thresholds."
              },
              "fullDescription": {
                "text": "A play exceeds size thresholds."
              },
              "help": {
                "text": "Split the play into cohesive task files or roles if doing so improves ownership and reuse."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "maintainability",
                "confidence": "low",
                "status": "stable",
                "taxonomy": "MAINTAINABILITY_SIGNAL",
                "actionability": "actionable"
              }
            },
            {
              "id": "large-task",
              "shortDescription": {
                "text": "A task exceeds size thresholds."
              },
              "fullDescription": {
                "text": "A task exceeds size thresholds."
              },
              "help": {
                "text": "Replace a monolithic task with a native module or smaller named tasks where semantics permit."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "maintainability",
                "confidence": "low",
                "status": "stable",
                "taxonomy": "MAINTAINABILITY_SIGNAL",
                "actionability": "actionable"
              }
            },
            {
              "id": "ansible-lint-issue",
              "shortDescription": {
                "text": "ansible-lint reported an issue."
              },
              "fullDescription": {
                "text": "ansible-lint reported an issue."
              },
              "help": {
                "text": "Follow the native ansible-lint rule documentation identified by native_rule_id and help_url."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "lint",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "STYLE_POLICY",
                "actionability": "actionable"
              }
            },
            {
              "id": "unnamed-play",
              "shortDescription": {
                "text": "A play has no name:."
              },
              "fullDescription": {
                "text": "A play has no name:."
              },
              "help": {
                "text": "Add a concise, action-oriented name to the play."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "style",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "STYLE_POLICY",
                "actionability": "advisory"
              }
            },
            {
              "id": "unnamed-task",
              "shortDescription": {
                "text": "A task has no name:."
              },
              "fullDescription": {
                "text": "A task has no name:."
              },
              "help": {
                "text": "Add a concise task name that describes the intended state or action."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "style",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "STYLE_POLICY",
                "actionability": "advisory"
              }
            },
            {
              "id": "long-task-name",
              "shortDescription": {
                "text": "A task name exceeds the length threshold."
              },
              "fullDescription": {
                "text": "A task name exceeds the length threshold."
              },
              "help": {
                "text": "Shorten the name while preserving the operational intent developers need in Ansible output."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "style",
                "confidence": "low",
                "status": "stable",
                "taxonomy": "STYLE_POLICY",
                "actionability": "advisory"
              }
            },
            {
              "id": "inconsistent-naming-convention",
              "shortDescription": {
                "text": "A task or play name has excessive special characters."
              },
              "fullDescription": {
                "text": "A task or play name has excessive special characters."
              },
              "help": {
                "text": "Use the project's agreed task/play naming style and avoid decorative punctuation."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "style",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "STYLE_POLICY",
                "actionability": "advisory"
              }
            },
            {
              "id": "missing-file-extension",
              "shortDescription": {
                "text": "A file reference is missing a file extension."
              },
              "fullDescription": {
                "text": "A file reference is missing a file extension."
              },
              "help": {
                "text": "Use the complete referenced filename, including .yml/.yaml or the actual resource suffix."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "style",
                "confidence": "high",
                "status": "stable",
                "taxonomy": "STYLE_POLICY",
                "actionability": "advisory"
              }
            },
            {
              "id": "unnecessary-abstraction",
              "shortDescription": {
                "text": "A block: wraps exactly one task."
              },
              "fullDescription": {
                "text": "A block: wraps exactly one task."
              },
              "help": {
                "text": "Remove the one-child block unless it intentionally supplies shared conditions, privilege, or error handling."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "style",
                "confidence": "low",
                "status": "stable",
                "taxonomy": "STYLE_POLICY",
                "actionability": "advisory"
              }
            },
            {
              "id": "unnecessary-set-fact",
              "shortDescription": {
                "text": "A set_fact variable is never used."
              },
              "fullDescription": {
                "text": "A set_fact variable is never used."
              },
              "help": {
                "text": "Remove the unused fact or reference it through a visible, documented data flow."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "style",
                "confidence": "low",
                "status": "experimental",
                "taxonomy": "STYLE_POLICY",
                "actionability": "advisory"
              }
            },
            {
              "id": "unused-include-vars",
              "shortDescription": {
                "text": "An include_vars file's variables are never used."
              },
              "fullDescription": {
                "text": "An include_vars file's variables are never used."
              },
              "help": {
                "text": "Remove unused included variables or make their intended references explicit."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "style",
                "confidence": "low",
                "status": "experimental",
                "taxonomy": "STYLE_POLICY",
                "actionability": "advisory"
              }
            },
            {
              "id": "duplicate-task-names",
              "shortDescription": {
                "text": "Multiple tasks share the same name."
              },
              "fullDescription": {
                "text": "Multiple tasks share the same name."
              },
              "help": {
                "text": "Give each task a name that distinguishes its purpose or target."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "style",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "STYLE_POLICY",
                "actionability": "advisory"
              }
            },
            {
              "id": "incohesive-playbook",
              "shortDescription": {
                "text": "A playbook's tasks span multiple unrelated module domains (high module-domain entropy)."
              },
              "fullDescription": {
                "text": "A playbook's tasks span multiple unrelated module domains (high module-domain entropy)."
              },
              "help": {
                "text": "Review whether unrelated responsibilities should move into separate playbooks or roles."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "cohesion",
                "confidence": "low",
                "status": "experimental",
                "taxonomy": "MAINTAINABILITY_SIGNAL",
                "actionability": "advisory"
              }
            },
            {
              "id": "incohesive-play",
              "shortDescription": {
                "text": "A play's tasks span multiple unrelated module domains (high module-domain entropy)."
              },
              "fullDescription": {
                "text": "A play's tasks span multiple unrelated module domains (high module-domain entropy)."
              },
              "help": {
                "text": "Group related tasks together or split unrelated responsibilities after manually checking the semantic signal."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "cohesion",
                "confidence": "low",
                "status": "experimental",
                "taxonomy": "MAINTAINABILITY_SIGNAL",
                "actionability": "advisory"
              }
            },
            {
              "id": "missing-validate-certs",
              "shortDescription": {
                "text": "TLS certificate validation is disabled on an HTTPS module (uri/get_url)."
              },
              "fullDescription": {
                "text": "TLS certificate validation is disabled on an HTTPS module (uri/get_url)."
              },
              "help": {
                "text": "Enable certificate validation and configure the trusted CA; document and narrowly suppress only justified bootstrap exceptions."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "security",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "RISK",
                "actionability": "actionable"
              }
            },
            {
              "id": "deprecated-modules",
              "shortDescription": {
                "text": "A deprecated Ansible module is in use and may break in future versions."
              },
              "fullDescription": {
                "text": "A deprecated Ansible module is in use and may break in future versions."
              },
              "help": {
                "text": "Replace the deprecated module with the reported supported module/FQCN and test behavior on the target Ansible version."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "maintainability",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "MAINTAINABILITY_SIGNAL",
                "actionability": "actionable"
              }
            },
            {
              "id": "redirected-module",
              "shortDescription": {
                "text": "A legacy module name should use its current collection FQCN."
              },
              "fullDescription": {
                "text": "A legacy module name should use its current collection FQCN."
              },
              "help": {
                "text": "Use the reported current collection FQCN to make resolution explicit."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "compatibility",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "DEFECT",
                "actionability": "advisory"
              }
            },
            {
              "id": "missing-tags",
              "shortDescription": {
                "text": "Optional style policy: a task has no explicit or inherited tags."
              },
              "fullDescription": {
                "text": "Optional style policy: a task has no explicit or inherited tags."
              },
              "help": {
                "text": "Add an explicit or inherited tag only if the project needs selective execution; otherwise disable this optional rule."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "style",
                "confidence": "low",
                "status": "stable",
                "taxonomy": "STYLE_POLICY",
                "actionability": "informational"
              }
            },
            {
              "id": "shell-instead-of-module",
              "shortDescription": {
                "text": "A shell/command task could be replaced by a native Ansible module."
              },
              "fullDescription": {
                "text": "A shell/command task could be replaced by a native Ansible module."
              },
              "help": {
                "text": "Replace the recognized command with the suggested native Ansible module when its semantics match."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "maintainability",
                "confidence": "low",
                "status": "experimental",
                "taxonomy": "MAINTAINABILITY_SIGNAL",
                "actionability": "actionable"
              }
            },
            {
              "id": "missing-handler",
              "shortDescription": {
                "text": "A notify references a handler that does not exist."
              },
              "fullDescription": {
                "text": "A notify references a handler that does not exist."
              },
              "help": {
                "text": "Define the notified handler or correct the notify/listen name so repository-wide resolution succeeds."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "correctness",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "DEFECT",
                "actionability": "actionable"
              }
            },
            {
              "id": "unused-handler",
              "shortDescription": {
                "text": "A handler is defined but never notified."
              },
              "fullDescription": {
                "text": "A handler is defined but never notified."
              },
              "help": {
                "text": "Remove the handler or add the intended notify edge from the task that changes its resource."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "maintainability",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "MAINTAINABILITY_SIGNAL",
                "actionability": "actionable"
              }
            },
            {
              "id": "complex-expression",
              "shortDescription": {
                "text": "A Jinja or conditional expression is excessively complex."
              },
              "fullDescription": {
                "text": "A Jinja or conditional expression is excessively complex."
              },
              "help": {
                "text": "Extract intermediate variables or split the condition into named, independently understandable checks."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "maintainability",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "MAINTAINABILITY_SIGNAL",
                "actionability": "actionable"
              }
            },
            {
              "id": "incomplete-task",
              "shortDescription": {
                "text": "An unresolved TODO/FIXME marker remains in configuration code."
              },
              "fullDescription": {
                "text": "An unresolved TODO/FIXME marker remains in configuration code."
              },
              "help": {
                "text": "Complete the marked work, link it to tracked work, or remove the stale marker."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "maintainability",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "MAINTAINABILITY_SIGNAL",
                "actionability": "actionable"
              }
            },
            {
              "id": "long-statement",
              "shortDescription": {
                "text": "A YAML source line exceeds the configured length threshold."
              },
              "fullDescription": {
                "text": "A YAML source line exceeds the configured length threshold."
              },
              "help": {
                "text": "Wrap or restructure the YAML/Jinja expression when possible; suppress only unavoidable generated values or URLs."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "style",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "STYLE_POLICY",
                "actionability": "advisory"
              }
            },
            {
              "id": "unstructured-module",
              "shortDescription": {
                "text": "An Ansible role does not follow the conventional directory layout."
              },
              "fullDescription": {
                "text": "An Ansible role does not follow the conventional directory layout."
              },
              "help": {
                "text": "Add the conventional role entry point or document/configure the intentional custom layout."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "structure",
                "confidence": "low",
                "status": "experimental",
                "taxonomy": "MAINTAINABILITY_SIGNAL",
                "actionability": "actionable"
              }
            },
            {
              "id": "empty-abstraction",
              "shortDescription": {
                "text": "A task file or nested task abstraction is empty."
              },
              "fullDescription": {
                "text": "A task file or nested task abstraction is empty."
              },
              "help": {
                "text": "Remove the empty file/block or add the intended tasks before enabling it."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "structure",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "MAINTAINABILITY_SIGNAL",
                "actionability": "actionable"
              }
            },
            {
              "id": "excessive-nesting",
              "shortDescription": {
                "text": "Nested block/rescue/always structures exceed the depth threshold."
              },
              "fullDescription": {
                "text": "Nested block/rescue/always structures exceed the depth threshold."
              },
              "help": {
                "text": "Extract nested blocks into named task files or roles and simplify shared conditions/error handling."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "maintainability",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "MAINTAINABILITY_SIGNAL",
                "actionability": "actionable"
              }
            },
            {
              "id": "missing-abstraction",
              "shortDescription": {
                "text": "A large task collection is not split into roles or included task files."
              },
              "fullDescription": {
                "text": "A large task collection is not split into roles or included task files."
              },
              "help": {
                "text": "Split the large task collection along cohesive responsibilities when that improves navigation and reuse."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "structure",
                "confidence": "low",
                "status": "stable",
                "taxonomy": "MAINTAINABILITY_SIGNAL",
                "actionability": "actionable"
              }
            },
            {
              "id": "broken-role-dependency",
              "shortDescription": {
                "text": "A local role dependency is missing, cyclic, or self-referential."
              },
              "fullDescription": {
                "text": "A local role dependency is missing, cyclic, or self-referential."
              },
              "help": {
                "text": "Correct the local role name, remove self/cyclic edges, or declare the external dependency explicitly."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "correctness",
                "confidence": "medium",
                "status": "stable",
                "taxonomy": "DEFECT",
                "actionability": "actionable"
              }
            },
            {
              "id": "unguarded-variable",
              "shortDescription": {
                "text": "A Jinja variable lacks a visible definition or safety guard."
              },
              "fullDescription": {
                "text": "A Jinja variable lacks a visible definition or safety guard."
              },
              "help": {
                "text": "Define the variable in visible scope or use default()/d()/is defined when absence is valid."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "category": "correctness",
                "confidence": "low",
                "status": "candidate",
                "taxonomy": "OPTIONAL_PRACTICE",
                "actionability": "informational"
              }
            },
            {
              "id": "insecure-permissions",
              "shortDescription": {
