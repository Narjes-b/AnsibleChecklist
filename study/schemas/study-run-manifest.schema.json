{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ansibleguard://schemas/study-run-manifest-v1.json",
  "title": "AnsibleGuard immutable study run manifest",
  "type": "object",
  "required": [
    "schema_version", "kind", "run_id", "repository_count", "profile",
    "configuration_sha256", "source_manifest_sha256", "tool", "state"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "ansibleguard-study-run"},
    "run_id": {"type": "string"},
    "repository_count": {"type": "integer", "minimum": 1},
    "profile": {"type": "string"},
    "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resolved_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"enum": ["prepared", "scanned", "reported"]},
    "tool": {
      "type": "object",
      "required": ["mode", "python", "version", "commit_sha"],
      "properties": {
        "mode": {"type": "string"},
        "python": {"type": "string"},
        "version": {"type": "string"},
        "git_ref": {"type": "string"},
        "commit_sha": {"type": "string"}
      }
    }
  }
}
